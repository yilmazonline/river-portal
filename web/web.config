<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Baglanti dizesi depoda DEGIL: sunucudaki connectionStrings.config (ornek: connectionStrings.config.example) -->
  <connectionStrings configSource="connectionStrings.config" />

  <!-- Gizli anahtarlar depoda DEGIL: sunucudaki secrets.config (ornek: secrets.config.example). Ayni anahtar orada varsa o gecerlidir. -->
  <appSettings file="secrets.config">
    <!-- ===== E-posta bildirimi (SMTP) - Office 365 ===== -->
    <add key="Smtp.Host" value="smtp.office365.com" />
    <add key="Smtp.Port" value="587" />
    <add key="Smtp.EnableSsl" value="true" />
    <add key="Smtp.User" value="portal@river.com.tr" />
    <add key="Smtp.From" value="portal@river.com.tr" />
    <add key="Demo.NotifyEmail" value="yilmaz.guney@river.com.tr" />
    <!-- Dosya paylasimi: transfer basina azami boyut (GB) ve depolama klasoru (bos = web klasorunun yanindaki transfer_data) -->
    <!-- Rol bazli karsilama videosu: ilk giriste bir kez (false = kapali). Dosyalar: App_Data\intro\intro-{rol}.mp4 + poster-{rol}.jpg (rol: partner, partneruser, customer, vendor, editor, support; dosyasi olmayan role karsilama gosterilmez) -->
    <add key="Intro.Enabled" value="true" />
    <!-- Alacak takibi: River Teklif siparisleri (ayni SQL Server). Portalin SQL kullanicisinin kaynak tabloda SELECT yetkisi olmali. -->
    <add key="Receivables.Source" value="[RiverTeklif].[dbo].[Siparisler]" />
    <add key="Receivables.VatRate" value="20" />
    <add key="Receivables.DefaultTermDays" value="15" />
    <add key="Receivables.LegacyCutoff" value="2026-09-01" />
    <add key="Receivables.DigestTo" value="yilmaz.guney@river.com.tr,deniz@river.com.tr" />
    <!-- Satis onerileri: bu tarihten itibaren olusturulan kanal siparisleri oneri olarak gelir -->
    <add key="SalesSuggest.From" value="2026-01-01" />
    <add key="Transfer.MaxGB" value="5" />
    <add key="Transfer.StoragePath" value="" />
    <add key="Broadcast.ToEmail" value="info@river.com.tr" />
    <add key="Support.NotifyEmail" value="destek@river.com.tr" />
    <!-- Her gun 12:00 bekleyen destek talepleri ozeti (Cron.aspx?key=...&job=pending). CC birden fazla adres alabilir (virgulle). -->
    <add key="Support.PendingDigestTo" value="destek@river.com.tr" />
    <add key="Support.PendingDigestCc" value="anter@chantierfilms.com" />
    <!-- Satis Materyalleri "Bana gonder": belge kullanicinin e-postasina gider, bu adres gizli kopyada (ragbet takibi) -->
    <add key="Materials.SendBcc" value="yilmaz.guney@river.com.tr" />
    <!-- Lead Merkezi: Apollo API. Anahtar sohbette paylasildi; sistem calisinca Apollo'da yenileyip yalniz burada guncelleyin. -->
    <add key="Apollo.SearchUrl" value="https://api.apollo.io/api/v1/mixed_people/api_search" />
    <add key="Apollo.MatchUrl" value="https://api.apollo.io/api/v1/people/match" />
    <!-- Lead Merkezi gonderim: Entra ID uygulama kaydi (Mail.Send, Mail.ReadWrite; Exchange erisim ilkesiyle YALNIZ fol.solutions kutulari). Degerleri sunucuda girin. -->
    <!-- Lead Merkezi: Claude ile kisisellestirme ve yanit siniflandirma (bos ise kural tabanli siniflandirma). -->
    <add key="Anthropic.Model" value="claude-haiku-5-5" />
    <!-- Destek talebi: River AI seciliyse talep gonderilmeden once bilgi tabanindan AI on yaniti (1 acik, 0 kapali) -->
    <!-- Kalici oturum cerezi imza anahtari (gizli; degistirilirse herkes bir kez yeniden giris yapar) -->
    <add key="Kb.PreAnswer" value="1" />
    <add key="UserCreate.BccEmail" value="yilmaz.guney@river.com.tr" />
    <add key="Site.BaseUrl" value="https://portal.folyazilim.com" />
  </appSettings>

  <system.web>
    <!-- App_Code + .aspx calisma zamaninda derlenir (bin/ DLL gerekmez). C# 5.0 derleyicisi. -->
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="51200" />
    <globalization culture="tr-TR" uiCulture="tr"
                   fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- Oturum tabanli kimlik (FormsAuth degil). Anonim erisim serbest; yetki kontrolu kodda (Auth.cs). -->
    <sessionState mode="InProc" timeout="60" />
    <authentication mode="None" />
    <authorization>
      <allow users="*" />
    </authorization>
    <customErrors mode="Off" />
    <pages validateRequest="false" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <!-- WebP: IIS varsayilan olarak tanimayabilir (404). Akademi temalari, kategori ve avatar gorselleri -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript; charset=utf-8" />
    </staticContent>

    <security>
      <requestFiltering>
        <!-- 50 MB yukleme tavani -->
        <requestLimits maxAllowedContentLength="52428800" />
        <!-- Destek ekleri (TicketFile.ashx) ve Akademi dokumanlari (TrainingFile.ashx) yalniz yetki kontrollu uclardan acilir; klasore dogrudan istek 404 -->
        <hiddenSegments>
          <add segment="ticketfiles" />
          <add segment="forumfiles" />
          <add segment="trainingdocs" />
        </hiddenSegments>
        <verbs allowUnlisted="true">
          <add verb="GET" allowed="true" />
          <add verb="POST" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <!-- WebDAV, .ashx uc noktasina POST'u engelledigi icin kaldirildi; .ashx handler'i POST'a acik yeniden tanimlandi. -->
    <modules>
      <remove name="WebDAVModule" />
      <!-- Uzantisiz adresler (/verify) icin yonlendirme modulu tum isteklerde calissin -->
      <remove name="UrlRoutingModule-4.0" />
      <add name="UrlRoutingModule-4.0" type="System.Web.Routing.UrlRoutingModule" preCondition="" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <remove name="SimpleHandlerFactory-Integrated-4.0" />
      <add name="SimpleHandlerFactory-Integrated-4.0" path="*.ashx" verb="GET,HEAD,POST,DEBUG" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

  <!-- API klasoru: ASP.NET seviyesinde herkese acik (kimlik dogrulama kodda, X-Api-Key ile) -->
  <location path="api">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

</configuration>
